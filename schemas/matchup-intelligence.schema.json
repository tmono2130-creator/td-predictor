        "target_share": {
          "type": [
            "number",
            "null"
          ]
        },
        "team_carries": {
          "type": "integer",
          "minimum": 0
        },
        "rz_carries": {
          "type": "integer",
          "minimum": 0
        },
        "player": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "targets": {
          "type": "integer",
          "minimum": 0
        },
        "team_targets": {
          "type": "integer",
          "minimum": 0
        },
        "rz_targets": {
          "type": "integer",
          "minimum": 0
        },
        "player_id": {
          "type": "string",
          "pattern": "^00-[0-9]{7}$"
        },
        "carries": {
          "type": "integer",
          "minimum": 0
        },
        "snap_sample_games": {
          "type": "integer",
          "minimum": 0
        },
        "team_rz_opportunities": {
          "type": "integer",
          "minimum": 0
        },
        "rz_share": {
          "type": [
            "number",
            "null"
          ]
        },
        "rz_opportunities": {
          "type": "integer",
          "minimum": 0
        },
        "opponent": {
          "type": "string"
        },
        "game_id": {
          "type": "string"
        },
        "v5_probability_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "advantage": {
          "enum": [
            "Favorable",
            "Neutral",
            "Unfavorable",
            "Insufficient Data"
          ]
        },
        "explanation": {
          "type": "array",
          "items": {
            "type": "string"
          },
