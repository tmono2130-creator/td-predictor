        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/position"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "league": {
          "type": "object",
          "properties": {
            "sample": {
              "$ref": "#/$defs/sample"
            },
            "positions": {
              "type": "array",
